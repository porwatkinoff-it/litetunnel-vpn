+// realityUClient builds the fingerprint's ClientHello with an X25519MLKEM768
+// key share in front of X25519. Since XTLS/REALITY 8cdf7bf (Xray 26.9) the
+// server rejects a ClientHello without one; Chrome 131+ already has it, older
+// fingerprints (Safari, iOS, Firefox, Edge) get it added. Randomized
+// fingerprints have no fixed spec, and TLS 1.2 ones no key share: both are
+// left as they are.
+func realityUClient(conn net.Conn, config *utls.Config, id utls.ClientHelloID) (*utls.UConn, error) {
+	spec, err := utls.UTLSIdToSpec(id)
+	if err != nil || !slices.ContainsFunc(spec.Extensions, func(extension utls.TLSExtension) bool {
+		_, isKeyShare := extension.(*utls.KeyShareExtension)
+		return isKeyShare
+	}) {
+		return utls.UClient(conn, config, id), nil
+	}
+	for _, extension := range spec.Extensions {
+		switch ext := extension.(type) {
+		case *utls.SupportedCurvesExtension:
+			if !slices.Contains(ext.Curves, utls.X25519MLKEM768) {
+				ext.Curves = slices.Insert(ext.Curves, realityHybridIndex(ext.Curves, func(curveID utls.CurveID) utls.CurveID {
+					return curveID
+				}), utls.X25519MLKEM768)
+			}
+		case *utls.KeyShareExtension:
+			if !slices.ContainsFunc(ext.KeyShares, func(share utls.KeyShare) bool {
+				return share.Group == utls.X25519MLKEM768
+			}) {
+				ext.KeyShares = slices.Insert(ext.KeyShares, realityHybridIndex(ext.KeyShares, func(share utls.KeyShare) utls.CurveID {
+					return share.Group
+				}), utls.KeyShare{Group: utls.X25519MLKEM768})
+			}
+		}
+	}
+	uConn := utls.UClient(conn, config, utls.HelloCustom)
+	err = uConn.ApplyPreset(&spec)
+	if err != nil {
+		return nil, err
+	}
+	return uConn, nil
+}
+
+// realityHybridIndex is where X25519MLKEM768 goes: before X25519, else after
+// the leading GREASE entries.
+func realityHybridIndex[T any](items []T, group func(T) utls.CurveID) int {
+	index := slices.IndexFunc(items, func(item T) bool {
+		return group(item) == utls.X25519
+	})
+	if index >= 0 {
+		return index
+	}
+	index = 0
+	for index < len(items) && group(items[index]) == utls.GREASE_PLACEHOLDER {
+		index++
+	}
+	return index
+}
