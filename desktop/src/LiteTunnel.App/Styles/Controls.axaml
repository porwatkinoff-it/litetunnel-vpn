<!-- The design guide (design/DESIGN.md) over the Fluent controls. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:LiteTunnel.App.Controls">

  <!-- Type -->
  <Style Selector="TextBlock, SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.headline">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.callout">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.caption, SelectableTextBlock.caption">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.footer">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="32,6,32,0" />
  </Style>
  <Style Selector="TextBlock.header">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Margin" Value="32,24,32,6" />
  </Style>
  <Style Selector="TextBlock.tabular, SelectableTextBlock.tabular">
    <Setter Property="FontFeatures" Value="{DynamicResource Font.Tabular}" />
  </Style>
  <Style Selector=":is(TemplatedControl).mono">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="c|Icon.accent">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="TextBlock.connected">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Connected}" />
  </Style>
  <Style Selector="c|Icon.connected">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Connected}" />
  </Style>
  <Style Selector="c|PingBars.connected">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Connected}" />
  </Style>
  <Style Selector="TextBlock.busy">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Busy}" />
  </Style>
  <Style Selector="c|Icon.busy">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Busy}" />
  </Style>
  <Style Selector="c|PingBars.busy">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Busy}" />
  </Style>
  <Style Selector="TextBlock.danger, SelectableTextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style Selector="c|Icon.danger">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style Selector="c|PingBars.danger">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style Selector="SelectableTextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Busy}" />
  </Style>
  <Style Selector="c|Icon.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="Ellipse.connected">
    <Setter Property="Fill" Value="{DynamicResource Brush.Connected}" />
  </Style>
  <Style Selector="Ellipse.danger">
    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
  </Style>

  <!-- Grouped lists -->
  <Style Selector="Border.group">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Margin" Value="16,0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Rectangle.sep">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Separator}" />
    <Setter Property="Margin" Value="16,0,0,0" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="Grid.row">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Margin" Value="16,0" />
  </Style>
  <Style Selector="DockPanel.row">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Margin" Value="16,0" />
  </Style>
  <Style Selector="Panel.row">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Margin" Value="16,0" />
  </Style>
  <Style Selector=":is(Panel).row > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Panel).row > ComboBox">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="160" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
  </Style>
  <Style Selector="ProgressBar.danger">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>

  <!-- Buttons without the Fluent frame: header tools, rows, text buttons, the power button -->
  <Style Selector="Button.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Body"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.plain:pointerover /template/ Border#Body">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="Button.plain:pressed /template/ Border#Body">
    <Setter Property="Background" Value="{DynamicResource Brush.Pressed}" />
  </Style>
  <Style Selector="Button.plain:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.tool">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tool TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.tool.strong TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.row.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.row.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.link TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ Border#Body">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Power button: ring, fill and icon in the status colour -->
  <Style Selector="Button.power">
    <Setter Property="CornerRadius" Value="56" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="Button.power:pointerover /template/ Border#Body, Button.power:pressed /template/ Border#Body">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.power:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>
  <Style Selector="Button.power:disabled">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.power Ellipse.fill">
    <Setter Property="Fill" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Opacity" Value="0.08" />
  </Style>
  <Style Selector="Button.power Ellipse.ring">
    <Setter Property="Stroke" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="Button.power.on">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Connected}" />
  </Style>
  <Style Selector="Button.power.on Ellipse.fill">
    <Setter Property="Fill" Value="{DynamicResource Brush.Connected}" />
    <Setter Property="Opacity" Value="0.18" />
  </Style>
  <Style Selector="Button.power.on Ellipse.ring">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Connected}" />
  </Style>
  <Style Selector="Button.power.busy">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Busy}" />
  </Style>
  <Style Selector="Button.power.busy Ellipse.fill">
    <Setter Property="Fill" Value="{DynamicResource Brush.Busy}" />
  </Style>
  <Style Selector="Button.power.busy Ellipse.ring">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Busy}" />
  </Style>

  <!-- Fold chevron -->
  <Style Selector="c|Icon.chevron">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
  </Style>
  <Style Selector="c|Icon.chevron.folded">
    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
  </Style>

  <!-- A small spinner. It turns only while shown: a hidden one costs no frames. -->
  <Style Selector="Path.spinner">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Data" Value="M 9,2 A 7,7 0 1 1 2,9" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
  </Style>
  <Style Selector="Path.spinner[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RenderTransform" Value="rotate(360deg)" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Banner on top -->
  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Margin" Value="16,8" />
    <Setter Property="BoxShadow" Value="0 4 16 0 #33000000" />
    <Setter Property="MaxWidth" Value="608" />
  </Style>
</Styles>
